# Copy this file to backend\.env and fill in the real values there.
# backend\.env holds secrets and must NEVER be committed (it is in .gitignore).
# Never paste these values into a chat or AI prompt.

# Supabase dashboard → Connect → Connection string → "Session pooler" (works on IPv4 networks).
# Replace [YOUR-PASSWORD] with your database password (no square brackets).
# Example shape: postgresql://postgres.abcdefgh:YOUR-PASSWORD@aws-1-eu-central-1.pooler.supabase.com:5432/postgres
DATABASE_URL=

# Signs the sign-in cookies. Long random text. Generate one with:
#   .\.venv\Scripts\python.exe -c "import secrets; print(secrets.token_urlsafe(48))"
# Changing it signs everyone out.
APP_SECRET_KEY=

# How long people stay signed in, in days.
SESSION_DAYS=7

# Set to true when the site runs on HTTPS (production). Keep false for http://localhost.
COOKIE_SECURE=false

APP_ENV=development
