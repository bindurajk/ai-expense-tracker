# Copy this file to backend\.env and fill in the real values there.
# backend\.env holds secrets and must NEVER be committed (it is in .gitignore).
# Never paste these values into a chat or AI prompt.

# Supabase dashboard → Connect → "Session pooler" connection string (works on IPv4 networks).
# Replace [YOUR-PASSWORD] with your database password.
# Example shape: postgresql://postgres.abcdefgh:[YOUR-PASSWORD]@aws-0-eu-west-2.pooler.supabase.com:5432/postgres
DATABASE_URL=

# Supabase dashboard → Project Settings → API → Project URL, e.g. https://abcdefgh.supabase.co
SUPABASE_URL=

# Only needed if your project still uses the legacy shared JWT secret
# (Project Settings → JWT Keys → Legacy JWT secret). New projects use published
# signing keys, which the backend fetches automatically from SUPABASE_URL — leave this empty.
SUPABASE_JWT_SECRET=

APP_ENV=development
